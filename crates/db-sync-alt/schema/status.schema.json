{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "db-sync-alt status response",
  "description": "Shared response contract for GET /status, GET /health and the status command. /status returns HTTP 200 in every state. /health uses HTTP 200 when healthy and HTTP 503 otherwise. All timestamps use UTC Unix seconds. Every property is present, with null for an unknown observation. Reasons explain failed health checks. Warnings are informational. Bounded status construction reads cached state and PostgreSQL without calling the provider.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status_schema_version",
    "service_version",
    "network",
    "node_release",
    "database_format",
    "keep_rule_version",
    "profile_hash",
    "updated_at",
    "state",
    "state_since",
    "state_reason",
    "retry_at",
    "serving",
    "sync",
    "provider_head",
    "provider_observed_at",
    "stored_tip",
    "confirmed_target",
    "served_target",
    "horizon",
    "lag",
    "tip_lag",
    "freshness",
    "progress",
    "last_update",
    "error_code",
    "poll_error_code",
    "last_error",
    "retention",
    "provider",
    "epochs",
    "integrity",
    "database",
    "reader",
    "policy",
    "warnings",
    "healthy",
    "reason_codes"
  ],
  "properties": {
    "status_schema_version": {
      "const": 1
    },
    "service_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$"
    },
    "network": {
      "enum": [
        "mainnet",
        "preprod",
        "preview"
      ]
    },
    "node_release": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "database_format": {
      "type": "integer",
      "minimum": 1
    },
    "keep_rule_version": {
      "type": "integer",
      "minimum": 1
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "updated_at": {
      "type": "number",
      "minimum": 0,
      "description": "UTC Unix seconds. Unknown observations are null where allowed."
    },
    "state": {
      "enum": [
        "restoring",
        "catching_up",
        "following",
        "waiting",
        "stopped_by_check"
      ]
    },
    "state_since": {
      "type": "number",
      "minimum": 0,
      "description": "UTC Unix seconds. Unknown observations are null where allowed."
    },
    "state_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/code"
        },
        {
          "type": "null"
        }
      ]
    },
    "retry_at": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "UTC Unix seconds. Unknown observations are null where allowed."
        },
        {
          "type": "null"
        }
      ]
    },
    "serving": {
      "enum": [
        "unknown",
        "unready",
        "ready",
        "revoked",
        "stopped"
      ],
      "description": "The node-facing database state. ready means the gate is open for complete checked data."
    },
    "sync": {
      "enum": [
        "unknown",
        "idle",
        "syncing",
        "degraded",
        "backoff",
        "quota_wait",
        "halted"
      ],
      "description": "Sync activity with the existing monitoring vocabulary. following uses idle, catch-up uses syncing, provider waits use backoff or quota_wait, and a failed check uses halted."
    },
    "provider_head": {
      "anyOf": [
        {
          "$ref": "#/$defs/chain_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_observed_at": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "description": "UTC Unix seconds. Unknown observations are null where allowed."
        },
        {
          "type": "null"
        }
      ]
    },
    "stored_tip": {
      "anyOf": [
        {
          "$ref": "#/$defs/chain_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "confirmed_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/chain_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "served_target": {
      "anyOf": [
        {
          "$ref": "#/$defs/chain_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon": {
      "anyOf": [
        {
          "$ref": "#/$defs/chain_point"
        },
        {
          "type": "null"
        }
      ]
    },
    "lag": {
      "$ref": "#/$defs/lag",
      "description": "Gap from confirmed_target to served_target. This preserves the finality-adjusted lag used by existing monitoring."
    },
    "tip_lag": {
      "$ref": "#/$defs/lag",
      "description": "Gap from provider_head to served_target, including the Cardano finality distance."
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_observation_age_seconds"
      ],
      "properties": {
        "provider_observation_age_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Monotonic age of the last successful provider head observation. Preserves the stack readiness check."
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks_remaining",
        "blocks_per_hour",
        "sampled_at",
        "estimated_tip_at"
      ],
      "properties": {
        "blocks_remaining": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "blocks_per_hour": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sampled_at": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_tip_at": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Catch-up rate and estimated completion time. Unknown rates and estimates are null."
    },
    "last_update": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "started_at",
            "finished_at",
            "duration_seconds",
            "blocks_written",
            "events_written",
            "rows_pruned"
          ],
          "properties": {
            "started_at": {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            "finished_at": {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            "duration_seconds": {
              "type": "number",
              "minimum": 0
            },
            "blocks_written": {
              "type": "integer",
              "minimum": 0
            },
            "events_written": {
              "type": "integer",
              "minimum": 0
            },
            "rows_pruned": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/code"
        },
        {
          "type": "null"
        }
      ]
    },
    "poll_error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/code"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "at",
            "block_height",
            "transaction_hash"
          ],
          "properties": {
            "code": {
              "$ref": "#/$defs/code"
            },
            "at": {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            "block_height": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "transaction_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seconds",
        "next_horizon_move_at"
      ],
      "properties": {
        "seconds": {
          "type": "integer",
          "minimum": 86400
        },
        "next_horizon_move_at": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc_day",
        "calls_today",
        "calls_previous_days",
        "poll_interval_seconds",
        "pace_requests_per_second",
        "requests_in_flight",
        "last_refusal"
      ],
      "properties": {
        "utc_day": {
          "type": "string",
          "format": "date"
        },
        "calls_today": {
          "type": "integer",
          "minimum": 0
        },
        "calls_previous_days": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "utc_day",
              "requests"
            ],
            "properties": {
              "utc_day": {
                "type": "string",
                "format": "date"
              },
              "requests": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "The seven previous UTC dates in descending date order. Counts include every sent attempt and survive restart. Today is reported separately."
        },
        "poll_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pace_requests_per_second": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "requests_in_flight": {
          "type": "integer",
          "minimum": 0
        },
        "last_refusal": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "http_status",
                "code",
                "at",
                "wait_until"
              ],
              "properties": {
                "http_status": {
                  "enum": [
                    402,
                    418,
                    429
                  ]
                },
                "code": {
                  "$ref": "#/$defs/code"
                },
                "at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "UTC Unix seconds. Unknown observations are null where allowed."
                },
                "wait_until": {
                  "type": "number",
                  "minimum": 0,
                  "description": "UTC Unix seconds. Unknown observations are null where allowed."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Calls sent by this database follower. Capacity is unknown. These counts cover its own attempts."
    },
    "epochs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_epoch",
        "newest_parameters_epoch",
        "newest_stake_epoch"
      ],
      "properties": {
        "current_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "newest_parameters_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "newest_stake_epoch": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unspent_outputs",
        "supply_check",
        "snapshot"
      ],
      "properties": {
        "unspent_outputs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "supply_check": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "passed",
                "checked_at"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "checked_at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "UTC Unix seconds. Unknown observations are null where allowed."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_digest",
                "created_at"
              ],
              "properties": {
                "content_digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "created_at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "UTC Unix seconds. Unknown observations are null where allowed."
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reachable",
        "checked_at",
        "age_seconds",
        "error_code",
        "size_bytes",
        "tls_available",
        "reader_check"
      ],
      "properties": {
        "reachable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "checked_at": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "description": "UTC Unix seconds. Unknown observations are null where allowed."
            },
            {
              "type": "null"
            }
          ]
        },
        "age_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/code"
            },
            {
              "type": "null"
            }
          ]
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "tls_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reader_check": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "passed",
                "checked_at",
                "error_code"
              ],
              "properties": {
                "passed": {
                  "type": "boolean"
                },
                "checked_at": {
                  "type": "number",
                  "minimum": 0,
                  "description": "UTC Unix seconds. Unknown observations are null where allowed."
                },
                "error_code": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/code"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reader": {
      "anyOf": [
        {
          "$ref": "#/$defs/reader"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_max_age_seconds",
        "serving_lag_max_blocks",
        "serving_lag_max_seconds"
      ],
      "properties": {
        "observation_max_age_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "serving_lag_max_blocks": {
          "type": "integer",
          "minimum": 1
        },
        "serving_lag_max_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "healthy": {
      "type": "boolean"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,95}$"
    },
    "chain_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "height",
        "hash",
        "timestamp"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 134217727
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "number",
          "minimum": 0,
          "description": "UTC Unix seconds. Unknown observations are null where allowed."
        }
      },
      "description": "Cardano chain point. Timestamp is the block time in UTC Unix seconds."
    },
    "lag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks",
        "seconds"
      ],
      "properties": {
        "blocks": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "reader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "privileges",
        "settings",
        "warnings"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "privileges": {
          "const": "node_relations_only"
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement_timeout",
            "idle_in_transaction_session_timeout",
            "search_path",
            "default_transaction_read_only",
            "connection_limit"
          ],
          "properties": {
            "statement_timeout": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "idle_in_transaction_session_timeout": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "search_path": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_transaction_read_only": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            },
            "connection_limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "healthy": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "following"
          },
          "serving": {
            "const": "ready"
          },
          "reason_codes": {
            "maxItems": 0
          },
          "error_code": {
            "type": "null"
          },
          "poll_error_code": {
            "type": "null"
          },
          "provider_head": {
            "type": "object"
          },
          "confirmed_target": {
            "type": "object"
          },
          "stored_tip": {
            "type": "object"
          },
          "served_target": {
            "type": "object"
          },
          "horizon": {
            "type": "object"
          },
          "reader": {
            "type": "object"
          },
          "freshness": {
            "properties": {
              "provider_observation_age_seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "lag": {
            "properties": {
              "blocks": {
                "type": "integer",
                "minimum": 0
              },
              "seconds": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "database": {
            "properties": {
              "reachable": {
                "const": true
              },
              "reader_check": {
                "type": "object",
                "properties": {
                  "passed": {
                    "const": true
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "waiting"
          }
        }
      },
      "then": {
        "properties": {
          "state_reason": {
            "$ref": "#/$defs/code"
          },
          "retry_at": {
            "type": "number",
            "minimum": 0,
            "description": "UTC Unix seconds. Unknown observations are null where allowed."
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "stopped_by_check"
          }
        }
      },
      "then": {
        "properties": {
          "state_reason": {
            "$ref": "#/$defs/code"
          },
          "last_error": {
            "type": "object"
          },
          "healthy": {
            "const": false
          }
        }
      }
    }
  ]
}
