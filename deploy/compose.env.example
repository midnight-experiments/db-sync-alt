# Settings for deploy/compose.yaml. Copy this file to compose.env next to it,
# adjust it and keep it private; it holds paths, never a secret.
# Leave an optional setting commented out: a line such as `DSA_SNAPSHOT=` with
# nothing after it passes an empty value, which the service refuses.

# One project per network on a host.
COMPOSE_PROJECT_NAME=db-sync-alt-mainnet
DSA_IMAGE=ghcr.io/midnight-experiments/db-sync-alt:0.5.1
# mainnet or preprod
DSA_NETWORK=mainnet

# The service runs as this user and group: the owner of DSA_SECRETS_DIR and
# DSA_SNAPSHOT_HOST_DIR (`id -u`, `id -g`).
DSA_UID=1000
DSA_GID=1000

# A private directory (mode 700, files mode 600) with postgres.password,
# owner.password, reader.password, provider.key, root-ca.crt, server.crt and
# server.key. README.md shows how to create them.
DSA_SECRETS_DIR=/srv/db-sync-alt/mainnet/secrets
# The daily snapshot files are written here.
DSA_SNAPSHOT_HOST_DIR=/srv/db-sync-alt/mainnet/snapshots

# /health and /status on 127.0.0.1 of the host.
DSA_HTTP_PORT=18080

# First start on an empty database: a snapshot file placed in
# DSA_SNAPSHOT_HOST_DIR, as the service sees it, and its published digest.
# Comment both out again once the service serves.
# DSA_SNAPSHOT=/var/lib/db-sync-alt/snapshots/<file>
# DSA_EXPECT_CONTENT_DIGEST=<content digest>

# The retention is stored in the database; a different value is refused unless
# DSA_CHANGE_RETENTION=true is set with it (docs/operations.md).
# DSA_RETENTION_SECONDS=604800
# DSA_CHANGE_RETENTION=true

# Optional settings, shown with their defaults.
# DSA_REQUESTS_PER_SECOND=8
# DSA_MAX_IN_FLIGHT=4
# DSA_POLL_INTERVAL_SECONDS=20
# DSA_PRUNE_INTERVAL_SECONDS=3600
# DSA_HEALTH_MAX_LAG_BLOCKS=9
# DSA_DATABASE_FATAL_AFTER_SECONDS=1800

# The daily snapshot file: the UTC time of day (HH:MM) and how many files to
# keep, shown with their defaults.
# DSA_SNAPSHOT_AT=00:30
# DSA_SNAPSHOT_KEEP=3
